# AI Face Replacement & Animation Studio - Environment Configuration

# Execution device: "auto", "cpu", or "cuda"
DEVICE=auto

# Maximum upload limits
MAX_VIDEO_SIZE_MB=500
MAX_IMAGE_SIZE_MB=30

# Temporary processing directory
TEMP_DIRECTORY=./temp

# Models directory
MODELS_DIRECTORY=./models

# Optional path to system ffmpeg binary (if not in PATH or using bundled imageio-ffmpeg)
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe

